{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claim",
  "description": "A single factual claim with provenance. Source of truth for durable knowledge (SYSTEM_REQUIREMENTS.md section 5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "subject",
    "predicate",
    "object",
    "source",
    "source_type",
    "evidence",
    "discovered_at",
    "confidence",
    "freshness",
    "verification_state",
    "policy_state"
  ],
  "properties": {
    "claim_id": { "type": "string", "pattern": "^claim-[a-z0-9][a-z0-9-]*$" },
    "subject": { "type": "string", "minLength": 1 },
    "predicate": { "type": "string", "minLength": 1 },
    "object": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": ["spec", "official-docs", "official-repo", "registry", "third-party", "user-report"]
    },
    "evidence": { "type": "string", "pattern": "^ev-[a-z0-9][a-z0-9-]*$" },
    "discovered_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "verified_at": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "valid_from": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "valid_until": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "agent_id": { "type": "string", "minLength": 1 },
    "model_id": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "freshness": { "type": "string", "enum": ["fresh", "aging", "stale"] },
    "verification_state": {
      "type": "string",
      "enum": ["accepted", "conditional", "escalated", "rejected"]
    },
    "contradictions": { "type": "array", "items": { "type": "string" } },
    "policy_state": {
      "type": "string",
      "enum": ["auto-accepted", "conditional-accepted", "escalated", "rejected"]
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "action"],
        "properties": {
          "at": { "type": "string" },
          "agent_id": { "type": "string" },
          "action": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "supersedes": { "type": ["string", "null"] },
    "superseded_by": { "type": ["string", "null"] }
  }
}
