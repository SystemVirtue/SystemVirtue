{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Entity",
  "description": "A stable ecosystem entity. Identity survives renaming via aliases and source identifiers (CANONICAL_DATA_MODEL.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity_id",
    "entity_type",
    "canonical_name",
    "aliases",
    "source_ids",
    "evidence_ids",
    "lifecycle_state",
    "history"
  ],
  "properties": {
    "entity_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$" },
    "entity_type": {
      "type": "string",
      "enum": [
        "organisation",
        "provider",
        "model",
        "agent",
        "mcp_server",
        "tool",
        "capability",
        "task",
        "integration",
        "licence",
        "source",
        "claim"
      ]
    },
    "canonical_name": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "source_ids": { "type": "object" },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ev-[a-z0-9][a-z0-9-]*$" }
    },
    "lifecycle_state": {
      "type": "string",
      "enum": ["active", "deprecated", "replaced", "unknown"]
    },
    "valid_from": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "valid_until": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "action"],
        "properties": {
          "at": { "type": "string" },
          "agent_id": { "type": "string" },
          "action": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
