{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event",
  "description": "An ecosystem change event that triggers agent work (SYSTEM_REQUIREMENTS.md section 7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_type", "subject", "detected_at", "source", "confidence", "affected_entities", "required_tasks", "priority"],
  "properties": {
    "event_id": { "type": "string", "pattern": "^evt-[a-z0-9][a-z0-9-]*$" },
    "event_type": {
      "type": "string",
      "enum": ["provider_change", "model_release", "deprecation", "licence_change", "availability_change", "price_change", "capability_change", "security_advisory"]
    },
    "subject": { "type": "string", "minLength": 1 },
    "detected_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "source": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "affected_entities": { "type": "array", "items": { "type": "string" } },
    "required_tasks": { "type": "array", "items": { "type": "string" } },
    "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
  }
}
