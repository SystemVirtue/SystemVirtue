{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Relationship",
  "description": "A typed, provenance-carrying relationship between entities (SYSTEM_REQUIREMENTS.md section 6).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relationship_id",
    "subject",
    "predicate",
    "object",
    "evidence_id",
    "confidence",
    "verification_state",
    "history"
  ],
  "properties": {
    "relationship_id": { "type": "string", "pattern": "^rel-[a-z0-9][a-z0-9-]*$" },
    "subject": { "type": "string", "minLength": 1 },
    "predicate": {
      "type": "string",
      "enum": [
        "PROVIDES",
        "IMPLEMENTS",
        "USES",
        "DEPENDS_ON",
        "ALTERNATIVE_TO",
        "SUBSTITUTE_FOR",
        "COMPLEMENTS",
        "SUPPORTED_BY",
        "HOSTED_BY",
        "EXPOSES",
        "REQUIRES",
        "AVAILABLE_THROUGH",
        "BELONGS_TO",
        "CAPABLE_OF",
        "TARGETS",
        "INTEGRATES_WITH",
        "DERIVED_FROM",
        "REPLACED_BY",
        "DEPRECATED_BY"
      ]
    },
    "object": { "type": "string", "minLength": 1 },
    "evidence_id": { "type": "string", "pattern": "^ev-[a-z0-9][a-z0-9-]*$" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "verification_state": {
      "type": "string",
      "enum": ["accepted", "conditional", "escalated", "rejected"]
    },
    "valid_from": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "valid_until": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "action"],
        "properties": {
          "at": { "type": "string" },
          "agent_id": { "type": "string" },
          "action": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
